{
  "name": "card-expense-tracker",
  "version": "1.0.2",
  "private": true,
  "main": "electron/main.cjs",
  "description": "Offline Windows desktop expense tracker for multiple cards",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "desktop": "npm run build && electron .",
    "desktop:dev": "electron . --dev",
    "dist": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "electron-updater": "^6.8.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.4.14",
    "electron": "^32.3.3",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.24",
    "tailwindcss": "^3.4.7",
    "vite": "^5.2.0"
  },
  "build": {
    "appId": "com.local.cardexpensetracker",
    "productName": "Card Expense Tracker",
    "artifactName": "Card-Expense-Tracker-Setup-${version}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "RavinduGit21",
        "repo": "Expences-Tracker"
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis"
      ]
    }
  }
}